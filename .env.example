# === Ứng dụng ===
# Local development: development. Server thật: production.
# Nếu thiếu hoặc nhập sai, ứng dụng mặc định về production (fail-closed).
APP_ENV=development
APP_URL=http://127.0.0.1:8000

# === Cơ sở dữ liệu ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=techpilot
DB_USER=root
DB_PASS=

# === AI Multi-Provider Configuration (Gemini -> Groq -> Qwen) ===
AI_PROVIDER_ORDER=gemini,groq,qwen
AI_TIMEOUT_SECONDS=20

# 1. Google Gemini (Primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# 2. Groq Cloud (Fallback 1)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_BASE=https://api.groq.com/openai/v1

# 3. QwenCloud / DashScope (Fallback 2)
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-flash
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# === VNPay (tùy chọn — COD chạy không cần) ===
# development + để trống cả hai credential: dùng local simulator.
# production: bắt buộc nhập credential thật; local simulator luôn bị tắt.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://127.0.0.1:8000/payment/vnpay-return
VNPAY_IPN_URL=
