{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow Remediation Execution Marker",
  "description": "Human-approved execution marker for workflow-remediation-executor. Must be validated before any git add/commit/push.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "purpose",
    "approved_by",
    "approval_ref",
    "exact_base_sha",
    "exact_target_branch",
    "approved_paths",
    "allow_commit",
    "allow_push",
    "allow_force_push",
    "allow_merge",
    "allow_mark_ready",
    "created_at"
  ],
  "properties": {
    "purpose": { "type": "string", "minLength": 1 },
    "approved_by": { "type": "string", "pattern": "^human:" },
    "approval_ref": { "type": "string", "format": "uri" },
    "exact_base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "exact_target_branch": { "type": "string", "pattern": "^fix/workflow-qa-v3-post-merge$" },
    "approved_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "allow_commit": { "type": "boolean", "enum": [true] },
    "allow_push": { "type": "boolean" },
    "allow_force_push": { "type": "boolean", "enum": [false] },
    "allow_merge": { "type": "boolean", "enum": [false] },
    "allow_mark_ready": { "type": "boolean", "enum": [false] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
