#!/bin/sh
# TechPilot — Pre-push hook
# Chặn push trực tiếp lên main/develop và branch không được phép.

ALLOWED="trung kim hieu dinh"

while read local_ref local_sha remote_ref remote_sha; do
    # Lấy tên branch từ ref
    PUSH_BRANCH=$(echo "$remote_ref" | sed 's|refs/heads/||')

    if [ "$PUSH_BRANCH" = "main" ] || [ "$PUSH_BRANCH" = "develop" ]; then
        echo ""
        echo "❌ CHẶN: Không được push trực tiếp lên nhánh '$PUSH_BRANCH'."
        echo "   Hãy tạo Pull Request trên GitHub."
        echo ""
        exit 1
    fi

    FOUND=0
    for b in $ALLOWED; do
        if [ "$PUSH_BRANCH" = "$b" ]; then
            FOUND=1
            break
        fi
    done

    if [ "$FOUND" = "0" ]; then
        echo ""
        echo "❌ CHẶN: Không được push nhánh '$PUSH_BRANCH'."
        echo "   Chỉ được push: trung, kim, hieu, dinh."
        echo "   Không được tự tạo nhánh mới trên remote."
        echo ""
        exit 1
    fi
done

exit 0
