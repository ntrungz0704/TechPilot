#!/usr/bin/env bash
set -euo pipefail

CONTRACT="${1:-checkpoints/CP03/TASK_CONTRACT.yaml}"
SCHEMA="${2:-docs/workflow/schemas/task-contract.schema.json}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI="$SCRIPT_DIR/lib/contract-cli.js"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "Usage: $0 [contract-path] [schema-path]"
  echo "  Default contract: checkpoints/CP03/TASK_CONTRACT.yaml"
  echo "  Default schema:  docs/workflow/schemas/task-contract.schema.json"
  exit 0
fi

for tool in node; do
  if ! command -v "$tool" &>/dev/null; then
    echo "FAIL: $tool is required"
    exit 1
  fi
done

for f in "$CONTRACT" "$SCHEMA" "$CLI"; do
  if [ ! -f "$f" ]; then
    echo "FAIL: File not found: $f"
    exit 1
  fi
done

node "$CLI" validate "$CONTRACT" "$SCHEMA" || {
  echo "FAIL: validate-contract"
  exit 1
}

echo "PASS: validate-contract"
exit 0
