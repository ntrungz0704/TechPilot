{
  "allowed_commands": ["node", "php", "bash"],
  "forbidden_patterns": [
    "bash -c",
    "node -e",
    "node -p",
    "php -r",
    "php -R"
  ],
  "arg_validation": {
    "require_relative": true,
    "forbid_absolute": true,
    "forbid_parent_ref": true,
    "approved_test_roots": [
      "tests/",
      "tests/browser/fixtures/",
      "tests/workflow/"
    ]
  }
}
