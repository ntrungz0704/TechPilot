#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MARKER_GATE="$SCRIPT_DIR/verify-remediation-marker"
PP="$SCRIPT_DIR/lib/path-policy.js"
PUSH_FLAG=""
MARKER=""
MARKER_ARG=""

# Parse args
while [ $# -gt 0 ]; do
  case "$1" in
    --marker)
      if [ -z "${2:-}" ]; then
        echo "FAIL: --marker requires a path argument"
        exit 1
      fi
      MARKER="$2"
      MARKER_ARG="--marker"
      shift 2
      ;;
    --push)
      PUSH_FLAG="--push"
      shift
      ;;
    -h|--help)
      echo "Usage: $0 --marker <path> [--push]"
      echo "  --marker <path>: Path to remediation marker (must be outside repo root)"
      echo "  --push: Also push to origin after commit (requires marker allow_push=true)"
      echo ""
      echo "Steps:"
      echo "  1. Verify git index is clean (no pre-staged files)"
      echo "  2. Verify remediation marker"
      echo "  3. Stage only files matching marker approved_paths"
      echo "  4. Verify staged set matches expected changes"
      echo "  5. Verify marker again against staged set"
      echo "  6. git commit with validated message"
      echo "  7. Push only if --push is specified and marker allows"
      exit 0
      ;;
    *)
      echo "FAIL: Unknown argument: $1"
      exit 1
      ;;
  esac
done

if [ -z "$MARKER" ]; then
  echo "FAIL: --marker <path> is required"
  exit 1
fi

for tool in node jq git; do
  if ! command -v "$tool" &>/dev/null; then echo "FAIL: $tool required"; exit 1; fi
done

# Step 0: Check git index is clean
echo "=== Step 0: Check git index ==="
if ! git diff --cached --quiet 2>/dev/null; then
  echo "FAIL: Pre-staged files are not allowed"
  git diff --cached --name-only 2>/dev/null | while IFS= read -r f; do echo "  Staged: $f"; done
  exit 1
fi
echo "OK: Git index is clean"

# Step 1: Verify marker
echo "=== Step 1: Verify remediation marker ==="
MARKER_CHECK_MODE="commit"
if [ "$PUSH_FLAG" = "--push" ]; then MARKER_CHECK_MODE="push"; fi
"$MARKER_GATE" "$MARKER_ARG" "$MARKER" "$MARKER_CHECK_MODE" || {
  echo "FAIL: Marker verification failed — not committing"
  exit 1
}

# Read marker info
PURPOSE=$(jq -r '.purpose' "$MARKER")
APPROVED_BY=$(jq -r '.approved_by' "$MARKER")
TARGET_BRANCH=$(jq -r '.exact_target_branch' "$MARKER")
CURRENT_BRANCH=$(git branch --show-current)

if [ "$CURRENT_BRANCH" != "$TARGET_BRANCH" ]; then
  echo "FAIL: Branch mismatch: $CURRENT_BRANCH != $TARGET_BRANCH"
  exit 1
fi

echo "OK: Marker verified for $PURPOSE (approved by $APPROVED_BY)"

# Build list of changed files (tracked + untracked)
CHANGED_FILES=$(mktemp)
STAGED_FILES=$(mktemp)

git diff --name-only HEAD -z 2>/dev/null | tr '\0' '\n' > "$CHANGED_FILES"
git ls-files --others --exclude-standard -z 2>/dev/null | tr '\0' '\n' >> "$CHANGED_FILES"
sort -u "$CHANGED_FILES" -o "$CHANGED_FILES"

# Read approved paths from marker
APPROVED_PATHS_JSON=$(jq -r '.approved_paths' "$MARKER")

# Cleanup trap: unstage files staged by wrapper if commit hasn't succeeded
STAGED_BY_WRAPPER=()
COMMIT_SUCCEEDED=0
cleanup_staged() {
  if [ "$COMMIT_SUCCEEDED" -eq 0 ] && [ "${#STAGED_BY_WRAPPER[@]}" -gt 0 ]; then
    echo "Cleanup: Unstaging files staged by wrapper"
    for sf in "${STAGED_BY_WRAPPER[@]}"; do
      git restore --staged -- "$sf" 2>/dev/null || true
    done
  fi
  rm -f "$CHANGED_FILES" "$STAGED_FILES" 2>/dev/null || true
}
trap cleanup_staged EXIT

# Step 2: Stage only files matching approved paths
echo "=== Step 2: Stage matching files ==="
STRAY_COUNT=0
STAGED_COUNT=0

while IFS= read -r f; do
  [ -z "$f" ] && continue
  if node "$PP" test "$f" "$APPROVED_PATHS_JSON" 2>/dev/null; then
    if git add "$f" 2>/dev/null; then
      STAGED_COUNT=$((STAGED_COUNT+1))
      STAGED_BY_WRAPPER+=("$f")
      echo "$f" >> "$STAGED_FILES"
    else
      echo "FAIL: Cannot stage file: $f"
      STRAY_COUNT=$((STRAY_COUNT+1))
    fi
  else
    echo "FAIL: File not in approved paths: $f"
    STRAY_COUNT=$((STRAY_COUNT+1))
  fi
done < "$CHANGED_FILES"

if [ "$STRAY_COUNT" -gt 0 ]; then
  echo "FAIL: $STRAY_COUNT file(s) could not be staged"
  exit 1
fi

if [ "$STAGED_COUNT" -eq 0 ]; then
  echo "OK: No files to commit"
  exit 0
fi
echo "OK: $STAGED_COUNT file(s) staged"

# Step 3: Verify staged set matches expected approved changed set
echo "=== Step 3: Verify staged set ==="
CACHED_LIST=$(mktemp)
git diff --cached --name-only 2>/dev/null > "$CACHED_LIST"
sort -u "$CACHED_LIST" -o "$CACHED_LIST"

if ! diff <(sort "$CHANGED_FILES") <(sort "$CACHED_LIST") > /dev/null 2>&1; then
  echo "FAIL: Staged set does not match expected changed files"
  echo "--- Expected (all changed) ---"
  cat "$CHANGED_FILES"
  echo "--- Staged (git diff --cached) ---"
  cat "$CACHED_LIST"
  rm -f "$CACHED_LIST"
  exit 1
fi
rm -f "$CACHED_LIST"
echo "OK: Staged set matches changed files exactly"

# Step 4: Verify marker again against staged set
echo "=== Step 4: Re-verify marker with staged set ==="
"$MARKER_GATE" "$MARKER_ARG" "$MARKER" "$MARKER_CHECK_MODE" || {
  echo "FAIL: Marker re-verification failed after staging"
  exit 1
}
echo "OK: Marker re-verified"

# Step 5: Commit
echo "=== Step 5: Committing ==="
STAGED_LIST_NAMES=$(git diff --cached --name-only 2>/dev/null | tr '\n' ' ')
COMMIT_MSG="fix(workflow): ${PURPOSE:-workflow remediation}

Approved by: $APPROVED_BY
Approval ref: $(jq -r '.approval_ref' "$MARKER")
Files: $STAGED_LIST_NAMES
"

git commit -m "$COMMIT_MSG" || {
  echo "FAIL: Commit failed"
  exit 1
}

COMMIT_SHA=$(git rev-parse HEAD)
COMMIT_SUCCEEDED=1
echo "OK: Committed at $COMMIT_SHA"

# Step 6: Push (optional)
if [ "$PUSH_FLAG" = "--push" ]; then
  echo "=== Step 6: Pushing ==="
  PUSH_BRANCH="fix/workflow-qa-v3-post-merge"
  if [ "$CURRENT_BRANCH" != "$PUSH_BRANCH" ]; then
    echo "FAIL: Push branch must be $PUSH_BRANCH, currently on $CURRENT_BRANCH"
    exit 1
  fi
  git push origin "$PUSH_BRANCH" || {
    echo "FAIL: Push failed"
    exit 1
  }
  echo "OK: Pushed to origin/$PUSH_BRANCH"
else
  echo "SKIP: Not pushing (use --push to push)"
fi

echo "PASS: commit-remediation"
exit 0
