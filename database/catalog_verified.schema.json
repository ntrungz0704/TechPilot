{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TechPilot Verified Catalog Schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "products"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sku",
          "canonical_model_key",
          "name",
          "slug",
          "category_slug",
          "brand",
          "model_number",
          "price",
          "stock",
          "status",
          "short_description",
          "specs",
          "sources",
          "verification"
        ],
        "properties": {
          "sku": { "type": "string", "minLength": 3 },
          "canonical_model_key": { "type": "string", "minLength": 3 },
          "name": { "type": "string", "minLength": 5 },
          "slug": { "type": "string", "minLength": 3 },
          "category_slug": { "type": "string", "minLength": 2 },
          "brand": { "type": "string", "minLength": 2 },
          "model_number": { "type": "string", "minLength": 2 },
          "price": { "type": "number", "minimum": 0 },
          "sale_price": { "type": ["number", "null"] },
          "stock": { "type": "integer", "minimum": 0 },
          "status": { "type": "string", "enum": ["active", "inactive"] },
          "short_description": { "type": "string", "minLength": 10 },
          "specs": { "type": "object" },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "is_primary"],
              "properties": {
                "path": { "type": "string" },
                "source_url": { "type": ["string", "null"] },
                "sha256": { "type": ["string", "null"] },
                "is_primary": { "type": "boolean" }
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "url", "checked_at"],
              "properties": {
                "type": { "type": "string", "enum": ["manufacturer", "retailer_price", "official_manual"] },
                "url": { "type": "string" },
                "checked_at": { "type": "string" }
              }
            }
          },
          "verification": {
            "type": "object",
            "required": ["status", "score", "verified_at"],
            "properties": {
              "status": { "type": "string", "enum": ["verified", "needs_review", "rejected"] },
              "score": { "type": "integer", "minimum": 0, "maximum": 100 },
              "verified_at": { "type": "string" },
              "notes": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
